# Copy to .env.local and fill in. Never commit .env.local.

# --- MongoDB Atlas ---
# Atlas -> Connect -> Drivers. Use the elisia-archive-app user, NOT the bot's user.
MONGODB_URI=mongodb+srv://elisia-archive-app:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=elisia_archive

# --- Cloudflare R2 (photos) ---
# R2 overview page -> Account ID (right side)
R2_ACCOUNT_ID=
# From the R2 API token scoped to the elisia-archive bucket only
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=elisia-archive
# Bucket -> Settings -> Public Development URL (https://pub-xxxx.r2.dev), no trailing slash
R2_PUBLIC_URL=

# --- Mod login (Better Auth) ---
# Random secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Site address: http://localhost:3000 locally, the real domain in production
BETTER_AUTH_URL=http://localhost:3000
